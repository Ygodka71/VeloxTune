<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>VeloxTune</AssemblyName>
    <AssemblyTitle>VeloxTune</AssemblyTitle>
    <Product>VeloxTune</Product>
    <Description>VeloxTune - Modern Dark Audio Player for MP3, AAC, FLAC, WAV, OGG, OPUS</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="NAudio.Vorbis" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <Resource Include="img\icon.png" />
    <Resource Include="img\playback_queue.png" />
    <Resource Include="img\playlist.png" />
    <Resource Include="img\audio.png" />
    <None Update="img\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
