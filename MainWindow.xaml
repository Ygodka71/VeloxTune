<Window x:Class="ModernPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VeloxTune"
        Icon="icon.ico"
        Width="500" Height="640"
        MinWidth="400" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Drawer Tab Navigation RadioButton Style -->
        <Style x:Key="DrawerTabRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#172235" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Border -->
    <Border x:Name="OuterBorder" Margin="0" CornerRadius="18" Background="#0C101A" BorderBrush="#222B3D" BorderThickness="1">
        <Grid ClipToBounds="True">
            <!-- Background Subtle Gradient & Radial Glow -->
            <Border CornerRadius="17" Background="#0C101A" />
            <Ellipse Width="420" Height="420" Margin="0,-120,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#182A4A" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Main Content Layout -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header / Titlebar -->
                    <RowDefinition Height="Auto" />
                    <!-- Center Cover Art Area (Responsive & Capped) -->
                    <RowDefinition Height="*" />
                    <!-- Timeline & Controls -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Header (Draggable, click-drag from maximized restores to windowed) -->
                <Border Grid.Row="0" 
                        Background="Transparent" 
                        MinHeight="60"
                        PreviewMouseLeftButtonDown="Header_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="Header_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Header_PreviewMouseLeftButtonUp"
                        Padding="20,12,16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Track Title & Artist -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtTitle" 
                                       Text="Нет файла" 
                                       FontSize="17" 
                                       FontWeight="SemiBold" 
                                       Foreground="#F8FAFC" 
                                       TextTrimming="CharacterEllipsis" 
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="TxtArtist" 
                                       Text="Откройте файл или перетащите сюда" 
                                       FontSize="12" 
                                       FontWeight="Normal" 
                                       Foreground="#94A3B8" 
                                       Margin="0,2,0,0" 
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Top Right: Window Controls + Queue, Shuffle, Repeat underneath -->
                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top">
                            
                            <!-- Row 1: Minimize, Maximize/Restore, Close -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- Minimize -->
                                <Button Style="{StaticResource ModernIconButton}" Click="BtnMinimize_Click" Width="30" Height="28" ToolTip="Свернуть">
                                    <Path Data="M 0 5 H 12" Stroke="#94A3B8" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <!-- Maximize / Restore -->
                                <Button x:Name="BtnMaximize" Style="{StaticResource ModernIconButton}" Click="BtnMaximize_Click" Width="30" Height="28" ToolTip="Развернуть" Margin="3,0,0,0">
                                    <Path x:Name="PathMaximize" Data="M 1 1 H 10 V 10 H 1 Z" Stroke="#94A3B8" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <!-- Close -->
                                <Button Style="{StaticResource ModernIconButton}" Click="BtnClose_Click" Width="30" Height="28" ToolTip="Закрыть" Margin="3,0,0,0">
                                    <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="#94A3B8" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>

                            <!-- Row 2: Playlists, Queue, Shuffle, Repeat (underneath window controls, enlarged buttons) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                
                                <!-- Playlists Button -->
                                <Button x:Name="BtnPlaylistsToggle" 
                                        Style="{StaticResource ModernIconButton}" 
                                        Click="BtnPlaylistsToggle_Click" 
                                        Width="36" Height="34" 
                                        Margin="0,0,3,0" 
                                        ToolTip="Плейлисты">
                                    <Image Source="pack://application:,,,/img/playlist.png" Width="20" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Button>

                                <!-- Queue Drawer Button -->
                                <Button x:Name="BtnPlaylistToggle" 
                                        Style="{StaticResource ModernIconButton}" 
                                        Click="BtnPlaylistToggle_Click" 
                                        Width="36" Height="34" 
                                        Margin="0,0,3,0" 
                                        ToolTip="Очередь воспроизведения"
                                        AllowDrop="True"
                                        DragEnter="PlaylistDrawer_DragEnter"
                                        DragOver="PlaylistDrawer_DragOver"
                                        DragLeave="PlaylistDrawer_DragLeave"
                                        Drop="PlaylistDrawer_Drop">
                                    <Image Source="pack://application:,,,/img/playback_queue.png" Width="20" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Button>

                                <!-- Repeat Button (Enlarged with Prominent Badge) -->
                                <Button x:Name="BtnRepeat" 
                                        Style="{StaticResource ModernIconButton}" 
                                        Click="BtnRepeat_Click" 
                                        Width="38" Height="34" 
                                        ToolTip="Повтор (Выкл)">
                                    <Grid Width="22" Height="22">
                                        <Path x:Name="PathRepeat" 
                                              Data="M 3 5 H 10 C 11.5 5 12 6 12 7.5 V 8.5 M 12 10.5 H 5 C 3.5 10.5 3 9.5 3 8 V 7 M 1 6.5 L 3 4.5 L 5 6.5 M 14 9 L 12 11 L 10 9" 
                                              Stretch="Uniform"
                                              Width="18" Height="18"
                                              Stroke="#94A3B8" 
                                              StrokeThickness="1.8" 
                                              StrokeLineJoin="Round" 
                                              StrokeStartLineCap="Round" 
                                              StrokeEndLineCap="Round" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" />
                                        <Border x:Name="BorderRepeatOneBadge" 
                                                Visibility="Collapsed" 
                                                Background="#0284C7" 
                                                CornerRadius="3" 
                                                Padding="3,1" 
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Bottom" 
                                                Margin="0,0,-3,-3">
                                            <TextBlock Text="1" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Center Album Cover Art (Capped at 300x300) -->
                <Grid Grid.Row="1" Margin="24,6,24,10">
                    <Viewbox Stretch="Uniform" MaxWidth="300" MaxHeight="300">
                        <Border x:Name="CoverArtContainer"
                                Width="260" Height="260"
                                CornerRadius="16"
                                Background="#141926"
                                BorderBrush="#252F44"
                                BorderThickness="1">
                            
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.55" />
                            </Border.Effect>

                            <!-- Album Cover Image with dynamic pixelated/smooth scaling -->
                            <Border CornerRadius="15" ClipToBounds="True">
                                <Image x:Name="ImgCoverArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                        </Border>
                    </Viewbox>
                </Grid>

                <!-- 3. Bottom Timeline & Modern Controls -->
                <Grid Grid.Row="2" Margin="24,0,24,18">
                    <Grid.RowDefinitions>
                        <!-- Timeline / Seekbar -->
                        <RowDefinition Height="Auto" />
                        <!-- Control Island Dock -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Seekbar Section: Click anywhere to jump immediately -->
                    <Grid Grid.Row="0" Margin="4,0,4,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="45" />
                        </Grid.ColumnDefinitions>

                        <!-- Elapsed Time -->
                        <TextBlock x:Name="TxtCurrentTime" 
                                   Text="00:00" 
                                   Grid.Column="0" 
                                   FontSize="12" 
                                   FontFamily="Segoe UI, Consolas" 
                                   Foreground="#94A3B8" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left" />

                        <!-- Seek Slider with Click-to-Jump, Drag, and Hover Time Preview Badge -->
                        <Grid Grid.Column="1" Margin="10,0">
                            <!-- Floating Hover Time Preview Badge (shows after 0.5s hover) -->
                            <Canvas ClipToBounds="False" IsHitTestVisible="False" VerticalAlignment="Center" Height="0">
                                <Border x:Name="BadgeSeekPreview" 
                                        Visibility="Collapsed" 
                                        Background="#162032" 
                                        BorderBrush="#38BDF8" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="7,3" 
                                        Canvas.Top="-30" 
                                        Canvas.Left="0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.75" />
                                    </Border.Effect>
                                    <TextBlock x:Name="TxtSeekPreview" 
                                               Text="00:00" 
                                               FontSize="11" 
                                               FontWeight="SemiBold" 
                                               FontFamily="Segoe UI, Consolas" 
                                               Foreground="#F8FAFC" />
                                </Border>
                            </Canvas>

                            <Slider x:Name="SliderSeek" 
                                    Minimum="0" 
                                    Maximum="100" 
                                    Value="0" 
                                    Style="{StaticResource ModernSlider}"
                                    MouseEnter="SliderSeek_MouseEnter"
                                    MouseMove="SliderSeek_MouseMove"
                                    MouseLeave="SliderSeek_MouseLeave"
                                    PreviewMouseLeftButtonDown="SliderSeek_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="SliderSeek_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="SliderSeek_PreviewMouseLeftButtonUp" />
                        </Grid>

                        <!-- Total Time -->
                        <TextBlock x:Name="TxtTotalTime" 
                                   Text="00:00" 
                                   Grid.Column="2" 
                                   FontSize="12" 
                                   FontFamily="Segoe UI, Consolas" 
                                   Foreground="#94A3B8" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Modern Controls Island -->
                    <Border Grid.Row="1" 
                            Background="#141A26" 
                            BorderBrush="#252F42" 
                            BorderThickness="1" 
                            CornerRadius="28" 
                            Padding="14,8" 
                            HorizontalAlignment="Center">
                        
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.4" />
                        </Border.Effect>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Open File Button -->
                            <Button x:Name="BtnOpenFile" 
                                    Style="{StaticResource ModernIconButton}" 
                                    Click="BtnOpenFile_Click" 
                                    Width="36" Height="36" 
                                    ToolTip="Открыть аудиофайл (Ctrl+O)">
                                <Path Data="M 1 3 C 1 2 2 1 3 1 H 6 L 8 3 H 13 C 14 3 15 4 15 5 V 12 C 15 13 14 14 13 14 H 3 C 2 14 1 13 1 12 Z" 
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                      StrokeThickness="1.5" 
                                      Fill="Transparent" />
                            </Button>

                            <!-- Stop Button -->
                            <Button x:Name="BtnStop" 
                                    Style="{StaticResource ModernIconButton}" 
                                    Click="BtnStop_Click" 
                                    Width="36" Height="36" 
                                    Margin="4,0,0,0"
                                    ToolTip="Остановить">
                                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" 
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>

                            <!-- Previous Track Button -->
                            <Button x:Name="BtnPrevious" 
                                    Style="{StaticResource ModernIconButton}" 
                                    Click="BtnPrevious_Click" 
                                    Width="40" Height="40" 
                                    Margin="4,0,0,0"
                                    ToolTip="Предыдущий файл">
                                <Path Data="M 1 2 H 3 V 12 H 1 Z M 12 2 L 4 7 L 12 12 Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>

                            <!-- Central Play / Pause Button -->
                            <Button x:Name="BtnPlayPause" 
                                    Style="{StaticResource MainPlayButtonStyle}" 
                                    Click="BtnPlayPause_Click" 
                                    Margin="8,0" 
                                    ToolTip="Воспроизведение / Пауза (Пробел)">
                                <Grid Width="16" Height="16">
                                    <Path x:Name="PathPlay" 
                                          Data="M 2 1 L 15 8 L 2 15 Z" 
                                          Fill="#FFFFFF" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Margin="2,0,0,0" />
                                    <Path x:Name="PathPause" 
                                          Data="M 1 1 H 5 V 15 H 1 Z M 9 1 H 13 V 15 H 9 Z" 
                                          Fill="#FFFFFF" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <!-- Next Track Button -->
                            <Button x:Name="BtnNext" 
                                    Style="{StaticResource ModernIconButton}" 
                                    Click="BtnNext_Click" 
                                    Width="40" Height="40" 
                                    Margin="0,0,4,0"
                                    ToolTip="Следующий файл">
                                <Path Data="M 2 2 L 10 7 L 2 12 Z M 11 2 H 13 V 12 H 11 Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>

                            <!-- Volume Button with Slider -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                <Button x:Name="BtnVolumeMute" 
                                        Style="{StaticResource ModernIconButton}" 
                                        Click="BtnVolumeMute_Click" 
                                        Width="36" Height="36" 
                                        ToolTip="Громкость / Без звука">
                                    <Path x:Name="PathVolume" 
                                          Data="M 1 5 H 4 L 8 1 V 13 L 4 9 H 1 Z M 10 4 C 11.5 5.5 11.5 8.5 10 10 M 12 2 C 14.5 4.5 14.5 9.5 12 12" 
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                          StrokeThickness="1.4" 
                                          StrokeStartLineCap="Round" 
                                          StrokeEndLineCap="Round" />
                                </Button>
                                <Slider x:Name="SliderVolume" 
                                        Width="64" 
                                        Margin="2,0,4,0" 
                                        Minimum="0" 
                                        Maximum="1" 
                                        Value="1" 
                                        SmallChange="0.05" 
                                        LargeChange="0.1" 
                                        Style="{StaticResource VolumeSlider}" 
                                        ValueChanged="SliderVolume_ValueChanged" 
                                        MouseEnter="SliderVolume_MouseEnter" 
                                        MouseMove="SliderVolume_MouseMove" 
                                        MouseLeave="SliderVolume_MouseLeave"
                                        PreviewMouseLeftButtonDown="SliderVolume_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="SliderVolume_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="SliderVolume_PreviewMouseLeftButtonUp"
                                        ToolTipService.InitialShowDelay="0" 
                                        ToolTip="Регулировка громкости: 100%" />
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. Modern Slide-over Drawer (Queue & Saved Playlists) -->
            <Grid x:Name="PlaylistDrawer" 
                  Visibility="Collapsed" 
                  Background="#0C101A" 
                  Margin="1"
                  AllowDrop="True"
                  DragEnter="PlaylistDrawer_DragEnter"
                  DragOver="PlaylistDrawer_DragOver"
                  DragLeave="PlaylistDrawer_DragLeave"
                  Drop="PlaylistDrawer_Drop">
                <Grid.RowDefinitions>
                    <!-- Header with Tabs -->
                    <RowDefinition Height="Auto" />
                    <!-- Main Body: Queue View OR Playlists View -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Drawer Header: Centered Navigation Tabs + Close Button (Draggable to restore from maximized) -->
                <Border Grid.Row="0" 
                        Padding="14,10" 
                        BorderBrush="#1E2738" 
                        BorderThickness="0,0,0,1" 
                        Background="#101622"
                        PreviewMouseLeftButtonDown="Header_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="Header_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Header_PreviewMouseLeftButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Close drawer button on LEFT -->
                        <Button x:Name="BtnDrawerClose" Grid.Column="0" Style="{StaticResource ModernIconButton}" Click="BtnDrawerClose_Click" Width="32" Height="32" ToolTip="Закрыть панель (Esc)">
                            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="#94A3B8" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- Centered Modern Segmented Pill Tabs: Playlists first, Queue second (matching main top bar order) -->
                        <Border Grid.Column="1" HorizontalAlignment="Center" Background="#141C2B" BorderBrush="#223147" BorderThickness="1" CornerRadius="10" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabRadioPlaylists" GroupName="DrawerTabs" Click="TabRadioPlaylists_Click" PreviewMouseLeftButtonDown="TabRadioPlaylists_PreviewMouseLeftButtonDown" Style="{StaticResource DrawerTabRadio}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtTabPlaylistsLabel" Text="Плейлисты" FontWeight="SemiBold" FontSize="13" />
                                        <Border Background="#1E293B" CornerRadius="9" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtPlaylistsCount" Text="0" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="TabRadioQueue" GroupName="DrawerTabs" IsChecked="True" Click="TabRadioQueue_Click" PreviewMouseLeftButtonDown="TabRadioQueue_PreviewMouseLeftButtonDown" Style="{StaticResource DrawerTabRadio}" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtTabQueueLabel" Text="Очередь" FontWeight="SemiBold" FontSize="13" />
                                        <Border Background="#1E293B" CornerRadius="9" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtQueueCount" Text="0" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- Spacer on Right to balance Center Tabs perfectly -->
                        <Border Grid.Column="2" Width="32" Height="32" />
                    </Grid>
                </Border>

                <!-- ================= TAB 1: QUEUE VIEW ================= -->
                <Grid x:Name="GridQueueView" Grid.Row="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Playlist Items ListBox with Drag-Drop Reorder Support and Insertion Indicators -->
                    <ListBox x:Name="LstPlaylist" 
                             Grid.Row="0" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Foreground="#F8FAFC" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                             MouseDoubleClick="LstPlaylist_MouseDoubleClick" 
                             AllowDrop="True"
                             DragEnter="PlaylistDrawer_DragEnter"
                             DragOver="PlaylistDrawer_DragOver"
                             DragLeave="PlaylistDrawer_DragLeave"
                             Drop="PlaylistDrawer_Drop"
                             PreviewMouseLeftButtonDown="LstPlaylist_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="LstPlaylist_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="LstPlaylist_PreviewMouseLeftButtonUp"
                             Padding="10,6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1C2436" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#25324D" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0">
                                    <Grid.RowDefinitions>
                                        <!-- Top Drop Insertion Line Indicator ("черточка") -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Item Content -->
                                        <RowDefinition Height="*" />
                                        <!-- Bottom Drop Insertion Line Indicator ("черточка") -->
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border x:Name="TopDropIndicator" Grid.Row="0" Height="2" Background="#38BDF8" CornerRadius="1" Margin="2,0,2,2" Visibility="Collapsed" />

                                    <Grid Grid.Row="1" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Drag grip handle -->
                                        <TextBlock Grid.Column="0" Text="⠿" FontSize="14" Foreground="#475569" VerticalAlignment="Center" Cursor="SizeNS" ToolTip="Потяните для изменения порядка" />

                                        <!-- Audio Track Icon (18x18 img/audio.png) -->
                                        <Image Grid.Column="1" Source="pack://application:,,,/img/audio.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                        <!-- Title & Artist -->
                                        <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="#F8FAFC" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,6,0" />

                                        <!-- Add to Queue Duplicate Button -->
                                        <Button Grid.Column="3" Style="{StaticResource ModernIconButton}" Click="BtnDuplicateQueueItem_Click" Tag="{Binding}" Width="24" Height="24" Margin="0,0,4,0" ToolTip="Добавить копию в очередь">
                                            <Path Data="M 2 6 H 10 M 6 2 V 10" Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Delete from Queue Button -->
                                        <Button Grid.Column="4" Style="{StaticResource ModernIconButton}" Click="BtnDeleteQueueItem_Click" Tag="{Binding}" Width="24" Height="24" Padding="5" ToolTip="Удалить из очереди">
                                            <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="#94A3B8" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>

                                    <Border x:Name="BottomDropIndicator" Grid.Row="2" Height="2" Background="#38BDF8" CornerRadius="1" Margin="2,2,2,0" Visibility="Collapsed" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Drop Cue Overlay (Text updated: ONLY 'Добавить в очередь воспроизведения') -->
                    <Border x:Name="DropCueQueue" 
                            Grid.Row="0" 
                            Visibility="Collapsed" 
                            Background="#F00B1120" 
                            BorderBrush="#06B6D4" 
                            BorderThickness="2" 
                            CornerRadius="12" 
                            Margin="12" 
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 12 4 L 12 20 M 4 12 L 20 12" Stroke="#06B6D4" StrokeThickness="3" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock x:Name="TxtDropCueLabel" Text="Добавить в очередь воспроизведения" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Queue Footer: Actions (Shuffle, Save as Playlist, Export, Clear & Add Files) with WrapPanel -->
                    <Border Grid.Row="1" Padding="10,8" BorderBrush="#1E2738" BorderThickness="0,1,0,0" Background="#101622">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Shuffle Queue Button -->
                            <Button x:Name="BtnShuffleQueue" Content="🔀 Перемешать" Click="BtnShuffleQueue_Click" Foreground="#38BDF8" Background="#141F30" BorderBrush="#25354F" BorderThickness="1" Padding="8,5" Margin="0,4,6,4" Cursor="Hand" ToolTip="Перемешать файлы в очереди">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                            </Button>
                            <!-- Save Queue as Playlist Button -->
                            <Button x:Name="BtnSaveQueueAsPlaylist" Content="★ В плейлист" Click="BtnSaveQueueAsPlaylist_Click" Foreground="#F59E0B" Background="#261E14" BorderBrush="#4A3B20" BorderThickness="1" Padding="8,5" Margin="0,4,6,4" Cursor="Hand" ToolTip="Сохранить текущую очередь как плейлист">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                            </Button>
                            <!-- Export Queue M3U8 -->
                            <Button x:Name="BtnSavePlaylist" Content="Экспорт..." Click="BtnSavePlaylist_Click" Foreground="#94A3B8" Background="#141C2B" BorderBrush="#24314A" BorderThickness="1" Padding="8,5" Margin="0,4,6,4" Cursor="Hand" ToolTip="Экспорт очереди в файл .m3u8">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                            </Button>
                            <!-- Clear Queue -->
                            <Button x:Name="BtnClearPlaylist" Content="Очистить" Click="BtnClearPlaylist_Click" Foreground="#EF4444" Background="#1A141A" BorderBrush="#3D1D24" BorderThickness="1" Padding="8,5" Margin="0,4,6,4" Cursor="Hand" ToolTip="Очистить всю очередь">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                            </Button>
                            <!-- Add Files -->
                            <Button x:Name="BtnAddFiles" Content="+ Добавить файлы" Click="BtnAddFiles_Click" Foreground="#06B6D4" Background="#162033" BorderBrush="#25344F" BorderThickness="1" Padding="10,5" Margin="0,4,0,4" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                            </Button>
                        </WrapPanel>
                    </Border>
                </Grid>

                <!-- ================= TAB 2: PLAYLISTS VIEW ================= -->
                <Grid x:Name="GridPlaylistsView" Grid.Row="1" Visibility="Collapsed">
                    <!-- Sub-view 1: Playlists Master (List of all playlists) -->
                    <Grid x:Name="ViewPlaylistsMaster" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Playlists Top Action Bar with WrapPanel -->
                        <Border Grid.Row="0" Padding="10,8" BorderBrush="#1E2738" BorderThickness="0,0,0,1" Background="#101622">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnShowCreatePlaylist" Content="+ Создать плейлист" Click="BtnShowCreatePlaylist_Click" Foreground="#38BDF8" Background="#132438" BorderBrush="#254163" BorderThickness="1" Padding="9,5" Margin="0,4,6,4" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                </Button>
                                <Button x:Name="BtnImportPlaylist" Content="Импорт M3U8..." Click="BtnImportPlaylist_Click" Foreground="#94A3B8" Background="#141C2B" BorderBrush="#24314A" BorderThickness="1" Padding="8,5" Margin="0,4,6,4" Cursor="Hand" ToolTip="Импортировать сохраненный плейлист из файла">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                </Button>
                                <Button x:Name="BtnQueueToPlaylist" Content="Очередь → Плейлист" Click="BtnSaveQueueAsPlaylist_Click" Foreground="#F59E0B" Background="#261E14" BorderBrush="#4A3B20" BorderThickness="1" Padding="8,5" Margin="0,4,0,4" Cursor="Hand" ToolTip="Превратить текущую очередь в новый плейлист">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <!-- Inline New Playlist Creator Panel -->
                        <Border x:Name="PanelCreatePlaylist" Grid.Row="1" Visibility="Collapsed" Background="#141E2E" Padding="12,10" BorderBrush="#203047" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewPlaylistName" Grid.Column="0" Height="28" Padding="6,4" Background="#0C121D" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" KeyDown="TxtNewPlaylistName_KeyDown" VerticalContentAlignment="Center" FontSize="13" />
                                <Button x:Name="BtnConfirmCreatePlaylist" Grid.Column="1" Content="Создать" Click="BtnConfirmCreatePlaylist_Click" Margin="6,0,0,0" Padding="10,4" Foreground="#FFFFFF" Background="#0284C7" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5" /></Style></Button.Resources>
                                </Button>
                                <Button x:Name="BtnCancelCreatePlaylist" Grid.Column="2" Content="Отмена" Click="BtnCancelCreatePlaylist_Click" Margin="4,0,0,0" Padding="8,4" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- Saved Playlists List -->
                        <ListBox x:Name="LstSavedPlaylists" 
                                 Grid.Row="2" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="#F8FAFC" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                 MouseDoubleClick="LstSavedPlaylists_MouseDoubleClick" 
                                 Padding="10,6">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="Margin" Value="0,3" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Background" Value="#121824" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#1E2A3E" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1A2438" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#38BDF8" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#202E47" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Playlist Icon -->
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="#162338" BorderBrush="#253A5A" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Path Data="M 4 8 H 16 M 4 12 H 16 M 4 16 H 11" Stroke="#38BDF8" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Title & Track Count -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FormattedInfo}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Shuffle & Play Playlist Button -->
                                        <Button Grid.Column="2" Style="{StaticResource ModernIconButton}" Click="BtnShuffleSavedPlaylist_Click" Tag="{Binding}" Width="28" Height="28" ToolTip="Перемешать и воспроизвести" Margin="0,0,4,0">
                                            <Path Data="M 1 10 L 4 7 M 1 2 L 5 6 L 8 9 L 11 9 M 8 6 L 11 9 L 8 12 M 8 3 L 11 3 L 11 6 M 7 3 L 11 3 L 6 6" Stroke="#38BDF8" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Play Playlist Button -->
                                        <Button Grid.Column="3" Style="{StaticResource ModernIconButton}" Click="BtnPlaySavedPlaylist_Click" Tag="{Binding}" Width="28" Height="28" ToolTip="Воспроизвести плейлист" Margin="0,0,4,0">
                                            <Path Data="M 2 2 L 10 7 L 2 12 Z" Fill="#06B6D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Delete Playlist Button -->
                                        <Button Grid.Column="4" Style="{StaticResource ModernIconButton}" Click="BtnDeleteSavedPlaylist_Click" Tag="{Binding}" Width="28" Height="28" ToolTip="Удалить плейлист">
                                            <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="#EF4444" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid> 

                    <!-- Sub-view 2: Playlist Detail (Viewing and editing songs in a specific playlist) -->
                    <Grid x:Name="ViewPlaylistDetail" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Detail Header: Back + Clickable Title to Rename + Actions WrapPanel -->
                        <Border Grid.Row="0" Padding="12,10" BorderBrush="#1E2738" BorderThickness="0,0,0,1" Background="#101622">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnBackToPlaylists" Grid.Column="0" Content="← Назад" Click="BtnBackToPlaylists_Click" Foreground="#94A3B8" Background="#141C2B" BorderBrush="#24314A" BorderThickness="1" Padding="8,4" Margin="0,0,10,0" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                </Button>

                                <!-- Clickable Playlist Title to Rename (Expands to fill available space) -->
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel x:Name="PanelPlaylistTitleView" Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="PanelPlaylistTitleView_MouseLeftButtonUp" ToolTip="Нажмите, чтобы переименовать">
                                        <TextBlock x:Name="TxtCurrentPlaylistTitle" Text="Плейлист" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Path Data="M 1 9 L 7 3 L 9 5 L 3 11 L 1 11 Z M 6 4 L 8 6" Stroke="#64748B" StrokeThickness="1.2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Переименовать" />
                                    </StackPanel>

                                    <!-- Inline Edit Box -->
                                    <TextBox x:Name="TxtCurrentPlaylistTitleEdit" 
                                             Visibility="Collapsed" 
                                             FontSize="14" 
                                             FontWeight="SemiBold" 
                                             Background="#0C121D" 
                                             Foreground="#F8FAFC" 
                                             BorderBrush="#38BDF8" 
                                             BorderThickness="1" 
                                             Padding="6,3" 
                                             Height="28" 
                                             VerticalContentAlignment="Center" 
                                             KeyDown="TxtCurrentPlaylistTitleEdit_KeyDown" 
                                             LostFocus="TxtCurrentPlaylistTitleEdit_LostFocus" />
                                </Grid>

                                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Toggle Play / Pause for current playlist -->
                                    <Button x:Name="BtnPlayCurrentPlaylistAll" Content="▶ Играть" Click="BtnPlayCurrentPlaylistAll_Click" Foreground="#FFFFFF" Background="#0284C7" BorderThickness="0" Padding="10,4" Margin="0,4,6,4" Cursor="Hand" ToolTip="Воспроизвести этот плейлист">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="BtnAddCurrentPlaylistToQueue" Content="+ В очередь" Click="BtnAddCurrentPlaylistToQueue_Click" Foreground="#38BDF8" Background="#132438" BorderBrush="#254163" BorderThickness="1" Padding="8,4" Margin="0,4,0,4" Cursor="Hand" ToolTip="Добавить треки из этого плейлиста в текущую очередь">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Playlist Songs List with Drag-and-Drop Reorder and Insertion Indicators -->
                        <ListBox x:Name="LstPlaylistSongs" 
                                 Grid.Row="1" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="#F8FAFC" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                 MouseDoubleClick="LstPlaylistSongs_MouseDoubleClick" 
                                 AllowDrop="True"
                                 Drop="LstPlaylistSongs_Drop"
                                 DragOver="LstPlaylistSongs_DragOver"
                                 DragLeave="LstPlaylistSongs_DragLeave"
                                 PreviewMouseLeftButtonDown="LstPlaylistSongs_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="LstPlaylistSongs_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="LstPlaylistSongs_PreviewMouseLeftButtonUp"
                                 Padding="10,6">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1C2436" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#25324D" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Drop Insertion Line Indicator ("черточка") -->
                                        <Border x:Name="TopDropIndicator" Grid.Row="0" Height="2" Background="#38BDF8" CornerRadius="1" Margin="2,0,2,2" Visibility="Collapsed" />

                                        <Grid Grid.Row="1" Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Reorder Grip Handle -->
                                            <TextBlock Grid.Column="0" Text="⠿" FontSize="14" Foreground="#475569" VerticalAlignment="Center" Cursor="SizeNS" ToolTip="Потяните вверх или вниз для изменения порядка в плейлисте" />

                                            <!-- Audio Track Icon (18x18 img/audio.png) -->
                                            <Image Grid.Column="1" Source="pack://application:,,,/img/audio.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                            <!-- Title & Artist -->
                                            <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="#F8FAFC" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,6,0" />

                                            <!-- Add to Queue Button -->
                                            <Button Grid.Column="3" Style="{StaticResource ModernIconButton}" Click="BtnAddSongToQueue_Click" Tag="{Binding}" Width="24" Height="24" Margin="0,0,4,0" ToolTip="Добавить в очередь">
                                                <Path Data="M 2 6 H 10 M 6 2 V 10" Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>

                                            <!-- Delete song from playlist button -->
                                            <Button Grid.Column="4" Style="{StaticResource ModernIconButton}" Click="BtnDeleteSongFromPlaylist_Click" Tag="{Binding}" Width="24" Height="24" Padding="5" ToolTip="Удалить файл из плейлиста">
                                                <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="#94A3B8" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>

                                        <!-- Bottom Drop Insertion Line Indicator ("черточка") -->
                                        <Border x:Name="BottomDropIndicator" Grid.Row="2" Height="2" Background="#38BDF8" CornerRadius="1" Margin="2,2,2,0" Visibility="Collapsed" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Detail Footer with WrapPanel -->
                        <Border Grid.Row="2" Padding="10,8" BorderBrush="#1E2738" BorderThickness="0,1,0,0" Background="#101622">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnShufflePlaylistOrder" Content="🔀 Перемешать" Click="BtnShufflePlaylistOrder_Click" Foreground="#38BDF8" Background="#141F30" BorderBrush="#25354F" BorderThickness="1" Padding="8,5" Margin="0,4,6,4" Cursor="Hand" ToolTip="Перемешать файлы в плейлисте">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                </Button>
                                <Button x:Name="BtnExportPlaylistDetail" Content="Экспорт M3U8..." Click="BtnExportCurrentPlaylist_Click" Foreground="#94A3B8" Background="#141C2B" BorderBrush="#24314A" BorderThickness="1" Padding="8,5" Margin="0,4,6,4" Cursor="Hand" ToolTip="Экспорт этого плейлиста в файл .m3u8">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                </Button>
                                <Button x:Name="BtnDeletePlaylistDetail" Content="Удалить плейлист" Click="BtnDeleteCurrentPlaylist_Click" Foreground="#EF4444" Background="#1A141A" BorderBrush="#3D1D24" BorderThickness="1" Padding="8,5" Margin="0,4,6,4" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                </Button>
                                <Button x:Name="BtnAddTracksDetail" Content="+ Добавить файлы" Click="BtnAddTracksToCurrentPlaylist_Click" Foreground="#06B6D4" Background="#162033" BorderBrush="#25344F" BorderThickness="1" Padding="10,5" Margin="0,4,0,4" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                </Button>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Fluent In-App Toast Notification -->
            <Border x:Name="ToastBorder" 
                    VerticalAlignment="Top" 
                    HorizontalAlignment="Center" 
                    Margin="0,48,0,0" 
                    Background="#F010192A" 
                    BorderBrush="#38BDF8" 
                    BorderThickness="1" 
                    CornerRadius="20" 
                    Padding="16,8" 
                    Opacity="0" 
                    IsHitTestVisible="False" 
                    Panel.ZIndex="1000">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 1 5 L 4 8 L 10 2" Stroke="#38BDF8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="ToastText" Text="Добавлено в очередь" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Fluent In-App Confirmation Modal Dialog -->
            <Grid x:Name="ModalConfirmOverlay" Visibility="Collapsed" Panel.ZIndex="2000" Background="#99000000">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Background="#141C2B" BorderBrush="#25354F" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="TxtModalTitle" Text="Удалить плейлист?" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8" />
                        <TextBlock x:Name="TxtModalMessage" Text="Вы действительно хотите удалить этот плейлист? Это действие нельзя отменить." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,20" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnModalCancel" Content="Отмена" Click="BtnModalCancel_Click" Foreground="#94A3B8" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="14,6" Margin="0,0,8,0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                            </Button>
                            <Button x:Name="BtnModalConfirm" Content="Удалить" Click="BtnModalConfirm_Click" Foreground="#FFFFFF" Background="#EF4444" BorderThickness="0" Padding="14,6" Cursor="Hand" FontWeight="SemiBold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. Edge and Corner Resizing Overlays (All borders & corners work smoothly) -->
            <!-- Left Edge (Horizontal) -->
            <Rectangle HorizontalAlignment="Left" Width="7" Margin="0,14,0,14" Cursor="SizeWE" Fill="Transparent" PreviewMouseLeftButtonDown="Resize_Left" />
            <!-- Right Edge (Horizontal) -->
            <Rectangle HorizontalAlignment="Right" Width="7" Margin="0,14,0,22" Cursor="SizeWE" Fill="Transparent" PreviewMouseLeftButtonDown="Resize_Right" />
            <!-- Top Edge (Vertical) -->
            <Rectangle VerticalAlignment="Top" Height="7" Margin="14,0,14,0" Cursor="SizeNS" Fill="Transparent" PreviewMouseLeftButtonDown="Resize_Top" />
            <!-- Bottom Edge (Vertical) -->
            <Rectangle VerticalAlignment="Bottom" Height="7" Margin="14,0,22,0" Cursor="SizeNS" Fill="Transparent" PreviewMouseLeftButtonDown="Resize_Bottom" />

            <!-- Top-Left Corner (Diagonal) -->
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14" Cursor="SizeNWSE" Fill="Transparent" PreviewMouseLeftButtonDown="Resize_TopLeft" />
            <!-- Top-Right Corner (Diagonal) -->
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top" Width="14" Height="14" Cursor="SizeNESW" Fill="Transparent" PreviewMouseLeftButtonDown="Resize_TopRight" />
            <!-- Bottom-Left Corner (Diagonal) -->
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeNESW" Fill="Transparent" PreviewMouseLeftButtonDown="Resize_BottomLeft" />
            
            <!-- Bottom-Right Corner (Both Horizontal and Vertical) with Visual Grip -->
